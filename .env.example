# Copiar para .env.local e preencher com os valores do teu projeto Supabase.
# O .env.local está no .gitignore e nunca deve ser versionado.

# Definições > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Definições > API > Project API keys > anon public
# Esta chave pode ser pública. A proteção vem das políticas de Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Definições > API > Project API keys > service_role
# NUNCA expor no cliente nem versionar. Só usada em Route Handlers no servidor,
# para criar contas de utilizador a partir da página de Definições.
SUPABASE_SERVICE_ROLE_KEY=
